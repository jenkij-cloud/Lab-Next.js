generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Message {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    message   String
    createdAt DateTime @default(now())
}

model Todo {
    id        String   @id @default(cuid())
    title     String
    completed Boolean  @default(false)
    createdAt DateTime @default(now())
}
